# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_CONTROL_PASSCODE: Optional server-side passcode for /secure-control-panel admin verification.
# If unset, the first authorized administrator can claim admin control via the secure one-time setup flow.
ADMIN_CONTROL_PASSCODE=
